//====================================================================
// control_unit.v  (updated with LW/SW support)
//
// New signals:
//   alu_src   - 0: ALU's B input comes from a register (R-type)
//               1: ALU's B input comes from the sign-extended
//                  immediate (LW/SW, computing a memory address)
//   mem_write - 1 for SW: write to data memory
//   mem_to_reg- 1 for LW: the value written back to the register
//               file comes from memory, not the ALU
//   reg_dst_rt- 1 for LW: the destination register is "rt", not
//               "rd" (I-type instructions have no rd field at all -
//               those bit positions are actually part of the
//               immediate instead)
//====================================================================

module control_unit (
    input      [5:0] opcode,
    input      [5:0] funct,
    output reg [3:0] alu_op,
    output reg       reg_write,
    output reg       branch_eq,
    output reg       branch_ne,
    output reg       alu_src,
    output reg       mem_write,
    output reg       mem_to_reg,
    output reg       reg_dst_rt,
    output reg       jump,      // JAL: unconditional jump to literal J-type address
    output reg       jump_reg,  // JR:  unconditional jump to address in $rs
    output reg       link       // JAL: write PC+1 into $31
);
    always @(*) begin
        alu_op     = 4'b0010;
        reg_write  = 1'b0;
        branch_eq  = 1'b0;
        branch_ne  = 1'b0;
        alu_src    = 1'b0;
        mem_write  = 1'b0;
        mem_to_reg = 1'b0;
        reg_dst_rt = 1'b0;
        jump       = 1'b0;
        jump_reg   = 1'b0;
        link       = 1'b0;

        case (opcode)
            6'b000000: begin // R-type
                reg_write = 1'b1;
                case (funct)
                    6'b100000: alu_op = 4'b0010; // ADD
                    6'b100010: alu_op = 4'b0110; // SUB
                    6'b100100: alu_op = 4'b0000; // AND
                    6'b100101: alu_op = 4'b0001; // OR
                    6'b101010: alu_op = 4'b0111; // SLT
                    6'b001000: begin // JR: PC = $rs, writes nothing
                        reg_write = 1'b0;
                        jump_reg  = 1'b1;
                    end
                    default:   reg_write = 1'b0;
                endcase
            end
            6'b000100: branch_eq = 1'b1; // BEQ
            6'b000101: branch_ne = 1'b1; // BNE
            6'b100011: begin // LW
                reg_write  = 1'b1;
                alu_src    = 1'b1;
                alu_op     = 4'b0010; // address = rs + immediate
                mem_to_reg = 1'b1;
                reg_dst_rt = 1'b1;
            end
            6'b101011: begin // SW
                alu_src   = 1'b1;
                alu_op    = 4'b0010; // address = rs + immediate
                mem_write = 1'b1;
            end
            6'b001000: begin // ADDI: rt = rs + sign_extend(immediate)
                reg_write  = 1'b1;
                alu_src    = 1'b1;
                alu_op     = 4'b0010; // ADD
                reg_dst_rt = 1'b1;
                // mem_to_reg, mem_write stay 0 - result comes straight
                // from the ALU to the register file, dmem untouched
            end
            6'b000011: begin // JAL: $31 = PC+1, PC = literal address
                jump      = 1'b1;
                link      = 1'b1;
                reg_write = 1'b1;
            end
            default: ; // NOP
        endcase
    end
endmodule